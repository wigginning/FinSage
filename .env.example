# ===== FinSage 环境配置样例（.env.example）=====
# 用法：复制为 .env 并按需填写。绝对不要把真实密钥/凭据提交到仓库。
# 所有值仅为本项目自动填充的样例，无任何真实敏感信息。

# ---- 应用 ----
FIN_APP_NAME=finsage
FIN_APP_ENV=dev          # dev / test / prod
FIN_DEBUG=false
FIN_HOST=0.0.0.0
FIN_PORT=8237

# ---- 请求头（透传给 request_id / trace_id，可自定义前缀）----
FIN_REQUEST_ID_HEADER=X-Request-Id
FIN_TRACE_ID_HEADER=X-Trace-Id

# ---- MySQL（FROZEN: MySQL 8，库 finsage，utf8mb4_0900_ai_ci）----
# 默认 DSN 与 docker-compose 默认口令对齐（finsage/finsage_dev_pw），使干净检出可一键启动。
# 端口 13306 对应 docker-compose.yml 的 "13306:3306" 宿主机映射；若你改用了其他映射请同步。
# 生产环境：请改用强随机口令并通过 $FIN_DB_PASSWORD 注入覆盖（compose 的 MYSQL_PASSWORD 同源），
# 不要复用本默认口令。
FIN_DB_URL=mysql+pymysql://finsage:finsage_dev_pw@localhost:13306/finsage?charset=utf8mb4

# ---- Redis（FROZEN，compose 映射 6579:6379）----
FIN_REDIS_URL=redis://localhost:6579/0

# ---- Milvus（FROZEN，etcd + Milvus dev 部署）----
FIN_MILVUS_HOST=localhost
FIN_MILVUS_PORT=19730

# ---- 模型资源策略 ----
# 本地预下载目录：只读，实现不得修改/覆盖；加载优先取本地。
FIN_MODEL_LOCAL_DIR=resources/models
# 在线兜底下载的缓存目录（可覆盖，避免重复下载）；仅当本地缺失/损坏时使用。
FIN_MODEL_CACHE_DIR=data/models-cache

# ---- 可选：外部服务（留空则禁用对应 Provider；绝不填真实密钥）----
# FIN_LLM_API_KEY=
# FIN_LLM_BASE_URL=

# ---- 财务数据源凭据（留空则对应 Provider 降为低优先/不可用）----
# Tushare 需注册 token（http://tushare.pro）。未配置时 TushareProvider 在
# Registry 中保持低优先（priority=90），仅 token 就绪才参与 failover。
# FIN_TUSHARE_TOKEN=

# 东财反爬补丁（opt-in，默认关闭）。东方财富强制反爬后 akshare/efinance 默认请求
# 会被断开；开启会通过伪造浏览器指纹 + 获取 NID 令牌规避东财反爬（合规风险，见
# eastmoney_patch 说明）。默认 false，开启即视为接受该风险。
# FIN_ENABLE_EASTMONEY_PATCH=false